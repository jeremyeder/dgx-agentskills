#!/bin/bash
# Pre-commit hook: lint TypeScript + shellcheck shell scripts
set -euo pipefail

echo "Running pre-commit checks..."

# TypeScript lint (only if TS files changed)
if git diff --cached --name-only | grep -q "^mcp-server/src/.*\.ts$"; then
  echo "  Linting TypeScript..."
  cd mcp-server
  npm run lint
  cd ..
fi

# Shellcheck (only if shell files changed)
SHELL_FILES=$(git diff --cached --name-only | grep "\.sh$" || true)
if [ -n "$SHELL_FILES" ]; then
  echo "  Checking shell scripts..."
  echo "$SHELL_FILES" | xargs shellcheck
fi

echo "Pre-commit checks passed."
