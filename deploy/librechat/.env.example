# LibreChat Environment Configuration
# Copy to .env and fill in secrets: cp .env.example .env
# Generate secrets: python3 -c "import secrets; print(secrets.token_hex(N))"

HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# MongoDB
MONGO_URI=mongodb://mongodb:27017/LibreChat

# Redis
USE_REDIS=true
REDIS_URI=redis://redis:6379

# Secrets — generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
CREDS_KEY=<generate: 16 bytes hex>
CREDS_IV=<generate: 8 bytes hex>
JWT_SECRET=<generate: 32 bytes hex>
JWT_REFRESH_SECRET=<generate: 32 bytes hex>

# Meilisearch
MEILI_NO_ANALYTICS=true
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=<generate: 16 bytes hex>
SEARCH=true

# RAG API
RAG_PORT=8100
RAG_API_URL=http://rag_api:8100

# Ollama (internal Docker network)
OLLAMA_BASE_URL=http://ollama:11434

# Registration
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false

# File handling
ALLOW_FILE_UPLOADS=true

# Built-in endpoint activation
ANTHROPIC_API_KEY=user_provided
ANTHROPIC_USE_VERTEX=true
ANTHROPIC_VERTEX_REGION=us-east5
OPENAI_API_KEY=user_provided
GOOGLE_SERVICE_KEY_FILE=/app/vertex-sa.json
