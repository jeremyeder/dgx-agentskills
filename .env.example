# DGX Spark MCP endpoint (used by Claude Code plugin)
SPARK_MCP_URL=http://your-spark.local:3100
SPARK_MCP_URL_TAILSCALE=http://your-spark:3100

# SSH (used by setup skill and deploy script)
SPARK_HOST=your-spark.local
SPARK_USER=your-username
SPARK_SSH_KEY=~/.ssh/id_ed25519

# Claude Code backend switching
SPARK_VLLM_ENDPOINT=http://your-spark.local:8000
SPARK_OLLAMA_ENDPOINT=http://your-spark.local:11434
